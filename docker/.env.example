# ===========================================
# Application Configuration
# ===========================================

# App Settings
APP_NAME=my-app
APP_PORT=3000
APP_ENV=production

# ===========================================
# Database
# ===========================================
DATABASE_URL=file:./data/app.db

# ===========================================
# Authentication (optional)
# ===========================================
# JWT_SECRET=your-random-secret-min-32-chars
# AUTH_ENABLED=false

# ===========================================
# LLM Provider Configuration
# ===========================================
# Uncomment and configure your LLM provider:

# OpenAI
# LLM_PROVIDER=openai
# OPEN_AI_KEY=sk-...
# OPEN_MODEL_PREF=gpt-4o

# Anthropic
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL_PREF=claude-sonnet-4-6

# Azure OpenAI
# LLM_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_KEY=your-key
# AZURE_OPENAI_MODEL_PREF=deployment-name

# Ollama (local)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_PATH=http://host.docker.internal:11434
# OLLAMA_MODEL_PREF=llama2

# LMStudio (local)
# LLM_PROVIDER=lmstudio
# LMSTUDIO_BASE_PATH=http://host.docker.internal:1234/v1
# LMSTUDIO_MODEL_PREF=model-name

# ===========================================
# Embeddings (optional)
# ===========================================
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL_PREF=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# ===========================================
# Storage
# ===========================================
STORAGE_DIR=/app/storage
UPLOAD_DIR=/app/data/uploads

# ===========================================
# Security
# ===========================================
# SIG_KEY=generate-random-string-32-chars
# SIG_SALT=generate-random-salt
